{
  "name": "meetflow-desktop",
  "version": "1.0.0",
  "description": "MeetFlow AI Desktop — WASAPI loopback audio capture via Electron built-in",
  "main": "electron/main.js",
  "author": "MeetFlow AI",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -s first \"npm run vite\" \"npm run electron:dev\"",
    "vite": "vite",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "build": "vite build && electron-builder",
    "build:win": "vite build && electron-builder --win --x64",
    "preview": "vite preview"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^31.1.0",
    "electron-builder": "^24.13.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "ai.meetflow.desktop",
    "productName": "MeetFlow Desktop",
    "directories": { "output": "dist-electron" },
    "files": ["dist/**/*", "electron/**/*"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
